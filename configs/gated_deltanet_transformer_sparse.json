{
  "model": {
    "class": "CausalLM", "vocab_size": 8192, "context_length": 2048, "d_model": 256,
    "tie_embeddings": false,
    "position_encoding": {"class": "RoPE", "args": {"base": 10000.0}},
    "input_embedding": {"class": "TokenEmbedding", "args": {}},
    "layers": [
      {"class": "TransformerBlock", "args": {
        "pre_norm": true,
        "norm": {"class": "RMSNorm", "args": {"eps": 1e-6}},
        "attention": {"class": "MultiHeadCausalSelfAttention", "args": {"n_heads": 4, "head_dim": 64, "bias": false, "dropout": 0.0}},
        "mlp": {"class": "SwiGLU", "args": {"d_ff": 768, "bias": false, "dropout": 0.0}},
        "residual": {"class": "GatedResidual", "args": {}}
      }},
      {"class": "TransformerBlock", "repeat": 5, "args": {
        "pre_norm": true,
        "norm": {"class": "RMSNorm", "args": {"eps": 1e-6}},
        "attention": {"class": "DeltaNetLinearAttention", "args": {"n_heads": 4, "head_dim": 64, "expand_v": 1.0}},
        "mlp": {"class": "SwiGLU", "args": {"d_ff": 768, "bias": false, "dropout": 0.0}},
        "residual": {"class": "GatedResidual", "args": {}}
      }},
      {"class": "TransformerBlock", "args": {
        "pre_norm": true,
        "norm": {"class": "RMSNorm", "args": {"eps": 1e-6}},
        "attention": {"class": "MultiHeadCausalSelfAttention", "args": {"n_heads": 4, "head_dim": 64, "bias": false, "dropout": 0.0}},
        "mlp": {"class": "SwiGLU", "args": {"d_ff": 768, "bias": false, "dropout": 0.0}},
        "residual": {"class": "GatedResidual", "args": {}}
      }}
    ],
    "final_norm": {"class": "RMSNorm", "args": {"eps": 1e-6}},
    "output_head": {"class": "LinearLMHead", "args": {"bias": false}},
    "initialization": {"class": "GPTStyleInit", "args": {"std": 0.02, "scale_residual_projections": true}}
  },
  "training": {
    "optimizer": {"class": "AdamW", "args": {"lr": 0.001, "betas": [0.9, 0.95], "eps": 1e-8, "weight_decay": 0.1}},
    "precision": "bf16", "tokens_per_step": 131072, "micro_batch_size": 8,
    "grad_clip": 1.0, "epochs": 1, "seed": 12345,
    "schedule": {"class": "CosineSchedule", "args": {"warmup_fraction": 0.015, "final_lr_fraction": 0.1}},
    "validation_interval_steps": 250, "checkpoint_interval_steps": 500,
    "log_interval_steps": 250, "compile": true
  },
  "data": {"train_bin": "train.bin", "eval_bin": "eval.bin"},
  "evaluation": {"validation_batches": 100}
}
